# Environment Configuration
# Copy this file to .env and adjust the values for your local setup.
# This file is for local development and should not be committed to git.

# Project
PROJECT_ROOT=

# Application Settings
APP_ENV=development
APP_DEBUG=true
APP_LOG_LEVEL=INFO

# Backend API (required by the Streamlit dashboard)
BACKEND_API_URL=http://localhost:8000

# Streamlit Configuration
STREAMLIT_PORT=8501
STREAMLIT_SERVER_ADDRESS=localhost

# DuckDB Configuration (used by backend; frontend never opens the file directly)
DUCKDB_PATH=./data/attribution.duckdb

# Provenance Settings
PROVENANCE_ENABLED=true
ATTRIBUTION_TRACKING=true

# Kafka (backend / testing)
KAFKA_CONSUMER_GROUP=flink-group-debug-123
TEST_KAFKA_BROKER=localhost:9092
TEST_DUCKDB_PATH=data/test.duckdb

# Kafka Connector JARs (absolute paths – backend only)
# KAFKA_CONNECTOR_JAR=/path/to/flink-sql-connector-kafka-3.1.0-1.18.jar
