{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "jdk",
            "name": "Run Pipeline (AttributionJob)",
            "request": "launch",
            "mainClass": "com.fyp.AttributionJob",
            "vmArgs": "--add-opens java.base/java.util=ALL-UNNAMED --add-opens java.base/java.lang=ALL-UNNAMED",
            "cwd": "${workspaceFolder}/backend"
        },
        {
            "type": "jdk",
            "name": "Serve API (ApiApplication)",
            "request": "launch",
            "mainClass": "com.fyp.ApiApplication",
            "vmArgs": "--add-opens java.base/java.util=ALL-UNNAMED --add-opens java.base/java.lang=ALL-UNNAMED",
            "cwd": "${workspaceFolder}/backend"
        },
        {
            "type": "jdk",
            "name": "Run HelloWorld",
            "request": "launch",
            "mainClass": "com.fyp.Main",
            "cwd": "${workspaceFolder}/backend"
        }
    ]
}
